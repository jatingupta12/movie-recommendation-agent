# Optional path for the local SQLite database. Defaults to ./data/weekend_watch.db
WEEKEND_WATCH_DATABASE_PATH=data/weekend_watch.db

# TMDB v3 API credentials. Either an API key or v4 read access token is required.
TMDB_API_KEY=
TMDB_ACCESS_TOKEN=

# Watchmode streaming availability. Region is an ISO 3166-1 alpha-2 country code.
WATCHMODE_API_KEY=
WATCHMODE_REGION=US
WATCHMODE_CACHE_TTL_HOURS=24

# Optional AI recommendation stages. If either is unavailable, the system falls back gracefully.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Local HTTP API for n8n; defaults to localhost only.
WEEKEND_WATCH_API_HOST=127.0.0.1
WEEKEND_WATCH_API_PORT=8000
